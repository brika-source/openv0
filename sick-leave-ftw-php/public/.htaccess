# Apache configuration for the public directory.
#
# The application routes entirely through index.php with query-string
# parameters, so no rewrite rules are required. These directives only add
# hardening and sensible defaults.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Never serve a dotfile.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Directory listings off; index.php is the default document.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>

# Optional: pretty root URL. Harmless when mod_rewrite is unavailable.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ index.php [L]
</IfModule>
