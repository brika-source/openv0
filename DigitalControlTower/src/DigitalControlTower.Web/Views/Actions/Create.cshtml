@model ActionItem
@{
    ViewData["Title"] = "New action";
}

<h1 class="h3 mb-3">New action</h1>

<form asp-action="Create" method="post" class="card card-body">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create action</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
