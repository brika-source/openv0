@using Microsoft.EntityFrameworkCore
@inject DigitalControlTower.Web.Data.ApplicationDbContext Db
@{
    var currentUser = Context.Request.Cookies["dct_user"];
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // Handles for the "acting as" picker in the header.
    var handles = await Db.Users.AsNoTracking().OrderBy(u => u.Handle).Select(u => u.Handle).ToListAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Digital Control Tower</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" asp-controller="Dashboard" asp-action="Index">
                <span class="text-info">&#9679;</span> Digital Control Tower
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Pillars" asp-action="Index">Pillars</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Projects" asp-action="Index">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Actions" asp-action="Index">Actions</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="WeekGrid" asp-action="Index">Week grid</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                </ul>
                <form class="d-flex align-items-center gap-2" asp-controller="Users" asp-action="SignInAs" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <span class="navbar-text small">Acting as</span>
                    <input class="form-control form-control-sm" type="text" name="handle" value="@currentUser"
                           list="user-handles" placeholder="brika.wm" style="width: 11rem" />
                    <datalist id="user-handles">
                        @foreach (var handle in handles)
                        {
                            <option value="@handle"></option>
                        }
                    </datalist>
                    <button class="btn btn-sm btn-outline-light" type="submit">Set</button>
                </form>
            </div>
        </div>
    </nav>
</header>
<div class="container-fluid px-4">
    <partial name="_Alerts" />
    @RenderBody()
</div>
<footer class="text-muted small text-center py-4">
    Digital Control Tower &middot; ASP.NET Core MVC on SQL Server
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
