@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Control tower dashboard</h1>
        <div class="text-muted small">
            @if (Model.CurrentWeek is not null)
            {
                <span>Current tracking week: <strong>@Model.CurrentWeek.Label</strong> (starting @Model.CurrentWeek.StartDate.ToString("dd MMM yyyy"))</span>
            }
            else
            {
                <span>No tracking calendar configured.</span>
            }
        </div>
    </div>
    <a class="btn btn-primary" asp-controller="Actions" asp-action="Create">New action</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="card kpi h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Actions</div>
            <div class="display-6">@Model.TotalActions</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card kpi h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Open</div>
            <div class="display-6 text-primary">@Model.OpenActions</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card kpi h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Complete</div>
            <div class="display-6 text-success">@Model.CompleteActions</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card kpi h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Past review date</div>
            <div class="display-6 text-danger">@Model.OverdueActions</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card kpi h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Projects</div>
            <div class="display-6">@Model.ProjectCount</div>
            <div class="small text-muted">@Model.ActiveProjects active</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card kpi h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Completion</div>
            <div class="display-6">@Model.CompletionRate<span class="fs-6">%</span></div>
        </div></div>
    </div>
</div>

@{
    // The axis covers whole months, so the last bar has room to sit inside it
    // and the final month is drawn in full — the same span the board uses.
    var tlAxisStart = new DateOnly(Model.TimelineStart.Year, Model.TimelineStart.Month, 1);
    var tlAxisEnd = new DateOnly(Model.TimelineEnd.Year, Model.TimelineEnd.Month, 1).AddMonths(1);
    var tlDays = Math.Max(1, tlAxisEnd.DayNumber - tlAxisStart.DayNumber);
    double tlPos(DateOnly d) => (d.DayNumber - tlAxisStart.DayNumber) * 100.0 / tlDays;
    var tlToday = DateOnly.FromDateTime(DateTime.UtcNow);
    var wlMax = Model.Workload.Count > 0 ? Model.Workload.Max(r => r.Total) : 0;
    var tlMonths = new List<DateOnly>();
    if (Model.Timeline.Count > 0)
    {
        var cursor = tlAxisStart;
        while (cursor < tlAxisEnd) { tlMonths.Add(cursor); cursor = cursor.AddMonths(1); }
    }
}

<div class="card mb-3">
    <div class="card-header d-flex flex-wrap align-items-baseline gap-2">
        <span class="fw-semibold">Workload by owner</span>
        <span class="text-muted small">Open and closed 90-day actions per person &middot; an action with two owners counts for each</span>
    </div>
    <div class="card-body">
        @if (wlMax == 0)
        {
            <div class="text-muted small">No action has an owner yet.</div>
        }
        else
        {
            <div class="chart-legend mb-3">
                <span class="chart-key"><i style="background:var(--chart-complete)"></i>Complete</span>
                <span class="chart-key"><i style="background:var(--chart-ontrack)"></i>On track</span>
                <span class="chart-key"><i style="background:var(--chart-attention)"></i>Needs attention</span>
                <span class="chart-key"><i style="background:var(--chart-overdue)"></i>Overdue</span>
            </div>
            @foreach (var row in Model.Workload)
            {
                <div class="wl-row">
                    <a class="wl-name handle" asp-controller="Actions" asp-action="Index" asp-route-Owner="@row.Handle">@row.Handle</a>
                    <div class="wl-track">
                        @if (row.Complete > 0)
                        {
                            <span class="wl-seg" style="width:@(((double)row.Complete / wlMax * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--chart-complete)" title="@row.Handle — Complete: @row.Complete"></span>
                        }
                        @if (row.OnTrack > 0)
                        {
                            <span class="wl-seg" style="width:@(((double)row.OnTrack / wlMax * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--chart-ontrack)" title="@row.Handle — On track: @row.OnTrack"></span>
                        }
                        @if (row.Attention > 0)
                        {
                            <span class="wl-seg" style="width:@(((double)row.Attention / wlMax * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--chart-attention)" title="@row.Handle — Needs attention: @row.Attention"></span>
                        }
                        @if (row.Overdue > 0)
                        {
                            <span class="wl-seg" style="width:@(((double)row.Overdue / wlMax * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--chart-overdue)" title="@row.Handle — Overdue: @row.Overdue"></span>
                        }
                    </div>
                    <div class="wl-total">@row.Total</div>
                </div>
            }
            <details class="mt-3">
                <summary class="small text-muted">Show the numbers as a table</summary>
                <div class="table-responsive mt-2">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Owner</th><th class="text-end">Complete</th><th class="text-end">On track</th><th class="text-end">Needs attention</th><th class="text-end">Overdue</th><th class="text-end">Total</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Workload)
                        {
                            <tr>
                                <td class="handle">@row.Handle</td>
                                <td class="text-end">@row.Complete</td>
                                <td class="text-end">@row.OnTrack</td>
                                <td class="text-end">@row.Attention</td>
                                <td class="text-end">@row.Overdue</td>
                                <td class="text-end fw-semibold">@row.Total</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap align-items-baseline gap-2">
        <span class="fw-semibold">Projects over time</span>
        <span class="text-muted small">
            @Model.Timeline.Count project@(Model.Timeline.Count == 1 ? "" : "s") placed by first and last planned date
            @if (Model.UndatedProjects > 0)
            {
                <text>&middot; @Model.UndatedProjects carry no date yet and are not shown</text>
            }
        </span>
    </div>
    <div class="card-body">
        @if (Model.Timeline.Count == 0)
        {
            <div class="text-muted small">No project carries a date yet, so there is nothing to place on a timeline.</div>
        }
        else
        {
            <div class="tl-scroll">
                <div class="tl-grid">
                    <div class="tl-axis">
                        <div></div>
                        <div class="tl-axis-months">
                            @foreach (var m in tlMonths)
                            {
                                <span class="tl-axis-month" style="left:@(tlPos(m).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%">@(m.Month == 1 ? m.ToString("MMM yyyy") : m.ToString("MMM"))</span>
                            }
                        </div>
                    </div>
                    @foreach (var row in Model.Timeline)
                    {
                        var left = tlPos(row.Start);
                        var width = Math.Max(0.6, tlPos(row.End) - left);
                        <div class="tl-row">
                            <a class="tl-label" asp-controller="Projects" asp-action="Details" asp-route-id="@row.ProjectId" title="@row.ProjectName">
                                <i class="tl-dot" style="background:var(--pillar-@(row.PillarIndex % 9))"></i>@row.ProjectName
                            </a>
                            <div class="tl-track">
                                @foreach (var m in tlMonths)
                                {
                                    <span class="tl-tick" style="left:@(tlPos(m).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                }
                                @if (tlToday >= tlAxisStart && tlToday < tlAxisEnd)
                                {
                                    <span class="tl-today" style="left:@(tlPos(tlToday).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%" title="Today"></span>
                                }
                                <span class="tl-bar"
                                      style="left:@(left.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%;width:@(width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--pillar-@(row.PillarIndex % 9))"
                                      title="@row.ProjectName (@row.PillarName) — @row.Start.ToString("dd MMM yyyy") to @row.End.ToString("dd MMM yyyy")@(row.FromOwnDates ? "" : " (from its actions)")"></span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <details class="mt-3">
                <summary class="small text-muted">Show the dates as a table</summary>
                <div class="table-responsive mt-2">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Project</th><th>Pillar</th><th>Starts</th><th>Ends</th><th>Dates from</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Timeline)
                        {
                            <tr>
                                <td><a asp-controller="Projects" asp-action="Details" asp-route-id="@row.ProjectId">@row.ProjectName</a></td>
                                <td>@row.PillarName</td>
                                <td>@row.Start.ToString("dd MMM yyyy")</td>
                                <td>@row.End.ToString("dd MMM yyyy")</td>
                                <td class="text-muted">@(row.FromOwnDates ? "the project" : "its actions")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card h-100 border-primary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><span aria-hidden="true">&#128197;</span> Digital team meeting</span>
                <a class="btn btn-sm btn-primary" asp-controller="Meetings" asp-action="Today">
                    @(Model.TodaysMeeting is null ? "Start today's meeting" : "Open today's meeting")
                </a>
            </div>
            <div class="card-body">
                @if (Model.TodaysMeeting is not null)
                {
                    <div class="mb-2">
                        <span class="badge bg-light text-dark border">@Model.TodaysMeeting.Serial</span>
                        <strong>@Model.TodaysMeeting.Title</strong>
                        <span class="text-muted small">@Model.TodaysMeeting.Date.ToString("dddd d MMMM yyyy")</span>
                    </div>
                    <div class="small mb-2">
                        Participants:
                        @if (Model.TodaysMeeting.Participants.Count == 0)
                        {
                            <span class="text-muted">none yet</span>
                        }
                        else
                        {
                            foreach (var person in Model.TodaysMeeting.Participants.Select(p => p.User)
                                .Where(u => u is not null).OrderBy(u => u!.Handle))
                            {
                                <span class="handle" title="@person!.Name">@person.Handle</span>
                            }
                        }
                    </div>
                }
                else
                {
                    <p class="mb-2 text-muted">
                        No meeting opened for today yet. Opening one creates it on today's date; you can change the
                        date, add participants, write the minutes and raise actions that flow into the master plan.
                    </p>
                }
                <div class="small text-muted">
                    @Model.MeetingActionsOpen open action(s) raised in meetings &middot;
                    <a asp-controller="Meetings" asp-action="Index">meetings action plan</a>
                    @if (Model.LastMeeting is not null)
                    {
                        <span>&middot; last meeting @Model.LastMeeting.Date.ToString("d MMM")</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Value added</div>
            <div class="card-body">
                <div class="d-flex justify-content-between"><span class="text-muted small">Financial value / year</span><strong>@Model.TotalFinancialValue.ToString("N0")</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted small">Labour hours saved</span><strong>@Model.TotalHoursSaved.ToString("N0")</strong></div>
                <hr class="my-2" />
                <div class="small">
                    <a asp-controller="Reports" asp-action="Value">Full value report</a>
                    @if (Model.ProjectsWithoutValue > 0)
                    {
                        <div class="mt-1">
                            <a class="text-danger" asp-controller="Reports" asp-action="Gaps" asp-route-filter="ProjectsWithoutValue">
                                @Model.ProjectsWithoutValue project(s) with no value captured
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header fw-semibold">Reminders</div>
            <div class="card-body">
                <div class="display-6">@Model.RemindersDueNextRun</div>
                <div class="small text-muted">
                    action(s) due @Model.ReminderTargetDate.ToString("ddd d MMM") — owners are mailed two days ahead.
                </div>
                <hr class="my-2" />
                <div class="small">
                    <a asp-controller="Reminders" asp-action="Index">Reminder queue</a>
                    @if (Model.ActionsWithoutDueDate > 0)
                    {
                        <div class="mt-1">
                            <a class="text-danger" asp-controller="Reports" asp-action="Gaps" asp-route-filter="ActionsWithoutDueDate">
                                @Model.ActionsWithoutDueDate open action(s) with no due date
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">Pillars</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead><tr>
                        <th>Pillar</th><th class="text-end">Projects</th><th class="text-end">Actions</th>
                        <th class="text-end">At risk</th><th style="width: 30%">Progress</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var pillar in Model.Pillars)
                    {
                        <tr>
                            <td><a asp-controller="Projects" asp-action="Index" asp-route-pillarId="@pillar.Id">@pillar.Name</a></td>
                            <td class="text-end">@pillar.Projects</td>
                            <td class="text-end">@pillar.Actions</td>
                            <td class="text-end">
                                @if (pillar.AtRisk > 0)
                                {
                                    <span class="badge bg-danger">@pillar.AtRisk</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td>
                                <div class="progress" style="height: 1.1rem">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width: @(pillar.Progress.ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                                        @pillar.Progress%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-semibold">Status mix</div>
            <div class="card-body">
                @foreach (var item in Model.StatusBreakdown)
                {
                    var share = Model.TotalActions == 0 ? 0 : Math.Round(100m * item.Count / Model.TotalActions, 1);
                    <div class="d-flex justify-content-between small">
                        <span><span class="badge @item.Status.BadgeClass()">@item.Status.DisplayName()</span></span>
                        <span class="text-muted">@item.Count (@share%)</span>
                    </div>
                    <div class="progress mb-2" style="height: .5rem">
                        <div class="progress-bar @item.Status.BadgeClass()" role="progressbar"
                             style="width: @(share.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">Needs attention</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead><tr><th>Serial</th><th>Action</th><th>Owner</th><th>Review</th><th>Status</th></tr></thead>
                    <tbody>
                    @if (Model.Attention.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted text-center py-3">Nothing overdue or at risk.</td></tr>
                    }
                    @foreach (var action in Model.Attention)
                    {
                        <tr>
                            <td><a asp-controller="Actions" asp-action="Details" asp-route-id="@action.Id">@action.Serial</a></td>
                            <td>
                                @action.Name
                                <div class="text-muted small">@action.WorkItem?.Project?.Name &middot; @action.WorkItem?.Name</div>
                            </td>
                            <td><partial name="_OwnerHandles" model="action" /></td>
                            <td>@(action.DueDate?.ToString("dd MMM") ?? "—")</td>
                            <td><partial name="_StatusBadge" model="action.Status" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Owner load</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Owner</th><th class="text-end">Open</th><th class="text-end">Complete</th></tr></thead>
                    <tbody>
                    @foreach (var owner in Model.TopOwners)
                    {
                        <tr>
                            <td><a class="handle" asp-controller="Actions" asp-action="Index" asp-route-Owner="@owner.Owner">@owner.Owner</a></td>
                            <td class="text-end">@owner.Open</td>
                            <td class="text-end text-success">@owner.Complete</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Recent changes</div>
            <ul class="list-group list-group-flush small">
                @if (Model.RecentActivity.Count == 0)
                {
                    <li class="list-group-item text-muted">No changes recorded yet.</li>
                }
                @foreach (var entry in Model.RecentActivity)
                {
                    <li class="list-group-item">
                        <a asp-controller="Actions" asp-action="Details" asp-route-id="@entry.ActionItemId">@entry.ActionItem?.Serial</a>
                        <span class="text-muted">@entry.Field</span>
                        @entry.FromValue <span class="text-muted">&rarr;</span> <strong>@entry.ToValue</strong>
                        <div class="text-muted">@entry.By &middot; @entry.At.ToString("dd MMM yyyy HH:mm")</div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
