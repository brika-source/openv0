@model WorkItem
@{ ViewData["Title"] = "New work item"; }

<h1 class="h3 mb-3">New work item <span class="text-muted fs-6">in @ViewBag.ProjectName</span></h1>

<form asp-action="Create" method="post" class="card card-body" style="max-width: 46rem">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProjectId" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-outline-secondary" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
