@model WorkItem
@{ ViewData["Title"] = Model.Name; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index">Projects</a></li>
        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.Project?.Name</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Name</h1>
        <div class="text-muted small">@Model.Project?.Pillar?.Name &middot; @Model.Project?.Name</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="Actions" asp-action="Create" asp-route-workItemId="@Model.Id">Add action</a>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="alert alert-light border" style="white-space: pre-wrap">@Model.Notes</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header fw-semibold">Actions</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead><tr><th>Serial</th><th>Action</th><th>Owner</th><th>Review</th><th>Status</th></tr></thead>
                    <tbody>
                    @if (Model.Actions.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted text-center py-3">No actions yet.</td></tr>
                    }
                    @foreach (var action in Model.Actions)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-controller="Actions" asp-action="Details" asp-route-id="@action.Id">@action.Serial</a></td>
                            <td>@action.Name</td>
                            <td class="text-nowrap"><partial name="_OwnerHandles" model="action" /></td>
                            <td class="text-nowrap">@(action.DueDate?.ToString("dd MMM yy") ?? "—")</td>
                            <td><partial name="_StatusBadge" model="action.Status" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header fw-semibold">Comments</div>
            <ul class="list-group list-group-flush small">
                @if (Model.Comments.Count == 0)
                {
                    <li class="list-group-item text-muted">No comments yet.</li>
                }
                @foreach (var comment in Model.Comments.OrderByDescending(c => c.At))
                {
                    <li class="list-group-item">
                        <div style="white-space: pre-wrap">@comment.Text</div>
                        <div class="text-muted">@comment.Author &middot; @comment.At.ToString("dd MMM yyyy HH:mm")</div>
                    </li>
                }
            </ul>
            <div class="card-body">
                <form asp-action="AddComment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="input-group input-group-sm">
                        <input class="form-control" name="text" placeholder="Add a comment" />
                        <button class="btn btn-outline-primary" type="submit">Post</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
