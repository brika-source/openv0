@model Project
@{ ViewData["Title"] = "Delete project"; }

<h1 class="h3 mb-3">Delete project</h1>

<div class="card card-body">
    <p class="text-danger">
        This removes the project, its @Model.Items.Count work item(s) and
        @Model.Items.Sum(i => i.Actions.Count) action(s), including their history.
    </p>
    <dl class="row small">
        <dt class="col-sm-2">Project</dt><dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Pillar</dt><dd class="col-sm-10">@Model.Pillar?.Name</dd>
        <dt class="col-sm-2">Status</dt><dd class="col-sm-10">@Model.Status.DisplayName()</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Delete permanently</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </form>
</div>
