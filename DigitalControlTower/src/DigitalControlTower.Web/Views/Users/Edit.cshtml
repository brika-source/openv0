@model AppUser
@{ ViewData["Title"] = $"Edit {Model.Handle}"; }

<h1 class="h3 mb-3">Edit <span class="handle">@Model.Handle</span></h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body" style="max-width: 34rem">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
