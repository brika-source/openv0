@model List<AppUser>
@{
    ViewData["Title"] = "Users";
    var actionCounts = ViewBag.ActionCounts as Dictionary<string, int> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Users</h1>
        <div class="text-muted small">Everyone is referenced by their mail alias, e.g. <span class="handle">brika.wm</span>.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create">New user</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr>
                <th>Handle</th><th>Full name</th><th>Email</th>
                <th class="text-end">Actions owned</th><th class="text-end">Projects owned</th><th class="text-end">Projects managed</th><th></th>
            </tr></thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <a class="handle" asp-controller="Actions" asp-action="Index" asp-route-Owner="@user.Handle">@user.Handle</a>
                        @if (user.IsProvisional)
                        {
                            <span class="badge bg-warning text-dark" title="Created while importing a free-text owner — confirm the address.">provisional</span>
                        }
                    </td>
                    <td>@user.Name</td>
                    <td class="small text-muted">@user.Email</td>
                    <td class="text-end">@(actionCounts.TryGetValue(user.Id, out var count) ? count : 0)</td>
                    <td class="text-end">@user.OwnedProjects.Count</td>
                    <td class="text-end">@user.ManagedProjects.Count</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
